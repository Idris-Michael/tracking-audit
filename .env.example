# Copy to .env. Generate the token with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=change-me-api-token-at-least-24-chars

# Who the scorecard footer says prepared it
PREPARED_BY="Fieldnote Digital (fictional agency)"

RATE_LIMIT_PER_MINUTE=30
MAX_BATCH=50
WORKER_CONCURRENCY=4

# Host port for the API and console
API_PORT=8080
